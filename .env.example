# Local con docker-compose.yml (postgres + mailpit)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remind_me?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/remind_me?schema=public"
JWT_SECRET="change-me-super-secret-min-16-chars"
JWT_EXPIRES_IN="15m"
OTP_TTL_MINUTES=10
OTP_LENGTH=6
MAIL_FROM="RemindMe <no-reply@example.com>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
PORT=3000
